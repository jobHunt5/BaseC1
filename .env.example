# Copy this file to .env and fill in real values.

# Port for the local server
PORT=5174

# === Data source for businesses in a map area ===
# Set PLACES_PROVIDER to one of: google | osm
# - google: uses Google Places API (recommended; richest data; needs API key)
# - osm:    uses free OpenStreetMap Overpass API (no key, sparser business data)
PLACES_PROVIDER=osm

# Google Places API key (only required when PLACES_PROVIDER=google)
# Get one at https://console.cloud.google.com/  -> APIs & Services -> Credentials
# You only need to enable: "Places API (New)".
# (Geocoding for the search box uses free OpenStreetMap Nominatim.)
GOOGLE_MAPS_API_KEY=

# (Optional) Serper.dev API key — LinkedIn verify + Seek/Indeed/LinkedIn Jobs search.
# Sign up at https://serper.dev (free tier available).
SERPER_API_KEY=

# Timeout for external job-board search (ms).
JOB_SEARCH_TIMEOUT_MS=6000

# Max businesses to contact-scan per scan (0 = all found in area).
ENRICH_LIMIT=0

# Parallel contact scans (each fetches 1–3 pages).
ENRICH_CONCURRENCY=6

# Background deep scans after map scan (website + jobs + LinkedIn per company).
DEEP_SCAN_CONCURRENCY=4

# === Coverage (Google Places) ===
# Pages of results to fetch per query (1 page = 20 results, max 3 = 60).
GOOGLE_MAX_PAGES=3
# Split the scan bbox into GRID×GRID cells to beat the per-query result cap.
# 2 = 4 cells (good for suburbs), 3 = 9 cells (dense CBD). Higher = more API calls.
GOOGLE_GRID=2
# Parallel Google API calls.
GOOGLE_CONCURRENCY=8

# How long (ms) to wait when fetching a company website before giving up.
ENRICH_TIMEOUT_MS=8000

# Faster timeout for background contact-only scans.
FAST_ENRICH_TIMEOUT_MS=4500

# User-agent used when crawling company websites.
ENRICH_USER_AGENT=AreaHuntBot/1.0 (+local job-area scanner)
